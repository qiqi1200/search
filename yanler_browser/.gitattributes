# Auto detect text files and normalize line endings
* text=auto

# Dart/Flutter source
*.dart text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows-specific
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.keystore binary
